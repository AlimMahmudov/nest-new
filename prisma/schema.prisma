 
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Todo {
  id Int @id @unique @default(autoincrement())
  title  String
  description   String
  image String
}


model Food {
  id Int @id @unique @default(autoincrement())
  title  String
  price   String
  image String
}
